{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "theme": {
    "name": "vercel"
  },
  "scroll": {
    "speed": 3.5,
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": false,
    "sound": false,
    "volume": 0.7999999999999999
  },
  "debug": {
    "devtools": true
  }
}
