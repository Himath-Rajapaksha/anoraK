    "react": {
      "mode": "subagent",
      "description": "ReAct agent that uses think-act-observe loop for reasoning through complex problems with tool use",
      "prompt": "You are a ReAct agent. For each task: 1) Think through the problem step by step. 2) Take an action using available tools. 3) Observe the result. 4) Repeat until you reach a final answer. Always show your reasoning before acting.",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "task-orchestrator": {
      "mode": "subagent",
      "description": "Task-oriented agent that breaks down objectives into clear steps and executes them systematically",
      "prompt": "You are a task-oriented agent. Break complex objectives into discrete steps with clear success criteria. Execute each step using available tools. Minimize back-and-forth - only ask questions when encountering blockers or needing approval.",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "rag": {
      "mode": "subagent",
      "description": "Retrieval-Augmented Generation agent for knowledge-intensive tasks requiring information synthesis from multiple sources",
      "prompt": "You are a RAG agent. When answering knowledge-intensive questions: 1) Identify what information you need. 2) Search and retrieve relevant sources. 3) Synthesize findings into a coherent response. 4) Cite your sources. Always ground your answers in retrieved context.",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "deep-research": {
      "mode": "subagent",
      "description": "Research agent for in-depth analysis requiring extensive information gathering and synthesis across multiple sources",
      "prompt": "You are a deep research agent. For complex research tasks: 1) Decompose the question into sub-queries. 2) Search multiple sources systematically. 3) Read and extract relevant information. 4) Synthesize findings into a comprehensive analysis. 5) Verify key facts. Take your time to be thorough - quality matters more than speed.",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "persona": {
      "mode": "subagent",
      "description": "Conversational agent with persona engineering for natural dialogue and user engagement",
      "prompt": "You are a conversational agent. Maintain consistent personality and tone. Track conversation context and reference previous messages when relevant. Adapt your communication style to the user. Be helpful, engaging, and natural in dialogue.",
