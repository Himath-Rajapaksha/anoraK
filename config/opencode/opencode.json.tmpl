    "build": {
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    "general": {
      "mode": "subagent",
      "description": "A general-purpose agent for researching complex questions and executing multi-step tasks.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "todowrite": "deny"
      }
    },
    "explore": {
      "mode": "subagent",
      "description": "A fast, read-only agent for exploring codebases.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "scout": {
      "mode": "subagent",
      "description": "A read-only agent for external docs and dependency research.",
