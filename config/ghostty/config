# ==========================================================================
#  Ghostty — universal config (Linux + macOS)
#  Paths use ~ which Ghostty expands, so this file is identical everywhere.
#  macOS reads this from ~/.config/ghostty/config as well as its app-support
#  path, so a single file is enough.
# ==========================================================================

font-family = "Ubuntu Mono"
font-size = 12

theme = Apple System Colors
background-opacity = 1

window-padding-x = 10
window-padding-y = 10
window-theme = auto
confirm-close-surface = false

# Slightly taller/wider cells than the font default — this font is cramped.
adjust-cell-height = 20%
adjust-cell-width = 5%

cursor-opacity = 0
cursor-style = block
cursor-style-blink = false

# Subtle CRT-ish glide on cursor movement.
custom-shader = "~/.config/ghostty/shaders/cursor_glide.glsl"

# --- keybinds ------------------------------------------------------------
# ctrl-c / ctrl-v stay copy/paste. Use ctrl-shift-c for SIGINT when needed:
#   ctrl+shift+i -> send literal ^C is not possible, so use the shell's
#   `kill -INT $$` if you ever really need to interrupt.
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+a=select_all
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+a=select_all

# Font size on the fly
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Tabs / splits
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface

# --- Linux-only extras (ignored on macOS) --------------------------------
# Ghostty warns rather than fails on unknown keys, so these are safe.
# gtk-single-instance = true
