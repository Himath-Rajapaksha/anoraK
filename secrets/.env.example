# anoraK/secrets/.env.example — copy to secrets/.env and fill in.
# secrets/.env is gitignored and chmod 600. Never commit real values.
#
# These are substituted into config templates at bootstrap time.

# --- OpenCode MCP --------------------------------------------------------
# Fine-grained PAT with read access to the repos you want the MCP to see.
# Leave empty to fall back to the gh CLI login.
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Reverse engineering -------------------------------------------------
# Detected automatically by 20-paths.zsh; set here to pin a version.
# GHIDRA_INSTALL_DIR=/opt/ghidra/ghidra_12.1.4_PUBLIC

# --- Optional MCP servers ------------------------------------------------
# CONTEXT7_API_KEY=
# SENTRY_AUTH_TOKEN=
# POSTGRES_URL=postgresql://user:pass@localhost:5432/db

# --- Machine identity ----------------------------------------------------
# Used by git config rendering if you ever want per-machine identity.
# GIT_AUTHOR_EMAIL=
