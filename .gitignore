# ==========================================================================
#  anoraK/.gitignore — nothing generated, secret, or machine-local gets in.
# ==========================================================================

# --- secrets (never, ever) ----------------------------------------------
secrets/.env
config/opencode/service.json

# --- generated at bootstrap ---------------------------------------------
config/opencode/opencode.json

# --- machine-local -------------------------------------------------------
config/zsh/zshrc.d/90-local.zsh

# --- OpenCode build artefacts -------------------------------------------
config/opencode/node_modules/
config/opencode/dist/
config/opencode/ecc-install-state.json
config/opencode/opencode.json.rea.backup

# --- backups created by bootstrap ---------------------------------------
*.anoraK.bak.*
*.bak.*

# --- OS / editor noise ---------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
